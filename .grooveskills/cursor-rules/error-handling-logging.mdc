## 3. Safe Try/Catch Pattern

```ts
import { Logger } from "@/utils/logger";
import { AppError } from "@/errors/app-error";
import { type ActionResponse, errorResponse, successResponse } from "@/types/response.types";

export async function executeSafeTask<T>(task: () => Promise<T>): Promise<ActionResponse<T>> {
  try {
    const result = await task();
    return successResponse(result);
  } catch (error: unknown) {
    if (error instanceof AppError) {
      Logger.warn("Expected domain error caught", { code: error.code, message: error.message });
      return errorResponse(error.message, error.statusCode);
    }

    Logger.error("Unhandled runtime exception in task execution", { error });
    return errorResponse("An unexpected error occurred. Please try again later.", 500);
  }
}
```

